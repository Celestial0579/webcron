#!/bin/sh
# webcron — ruft Cronjob-URLs nach Zeitplan auf.
#
# Fuer Webanwendungen, deren Hoster keine Cronjobs anbietet: Statt des
# fehlenden System-Crons ruft dieser Container die Cron-URL der Anwendung
# (wp-cron.php, cron.php, …) nach Zeitplan per HTTP auf.
#
# Aufrufarten:
#   webcron             Konfiguration pruefen, dann crond starten (Normalfall)
#   webcron --pruefen   nur die Konfiguration pruefen
#   webcron --einmal    jede URL sofort genau einmal aufrufen; Exit != 0,
#                       sobald ein Aufruf scheitert (fuer Probelaeufe/Tests)
#
# Konfiguration: /config/jobs.cron (WEBCRON_JOBS), eine Zeile je Aufruf:
#   <Minute> <Stunde> <Monatstag> <Monat> <Wochentag> <URL> [Name:Wert ...]
# Alles nach der URL sind HTTP-Kopfzeilen, z. B. X-Cron-Secret:abc123 —
# der richtige Platz fuer Secrets, denn anders als der Query-String tauchen
# Kopfzeilen nicht in Access-Logs auf.
set -eu
# Kein Globbing: Cron-Felder wie '*' werden unten per `set --` in Woerter
# zerlegt und wuerden sonst zu Dateinamen expandieren.
set -f

JOBS="${WEBCRON_JOBS:-/config/jobs.cron}"
CRONTAB="${WEBCRON_CRONTAB:-/etc/crontabs/root}"
LAUFDIR="${WEBCRON_LAUFDIR:-/run/webcron}"
UI_PORT="${WEBCRON_UI_PORT:-8080}"
MODUS="${1:-}"

fehler() { echo "webcron: $*" >&2; exit 1; }

case "$MODUS" in
    ""|--pruefen|--einmal) ;;
    *) fehler "unbekannter Aufruf '$MODUS' — erlaubt sind --pruefen und --einmal" ;;
esac

[ -f "$JOBS" ] || fehler "Konfiguration fehlt: $JOBS
Eine Datei mit Zeilen '<5 Cron-Felder> <URL> [Name:Wert ...]' dorthin
mounten, Vorlage: jobs.example.cron im Repo."

# Ein Cron-Feld: Ziffern, '*', ',', '-', '/' — mehr versteht busybox-crond
# nicht. Geprueft wird der Zeichenvorrat, nicht der Wertebereich; eine
# Minute '75' faellt erst crond auf.
ist_cronfeld() {
    case "$1" in
        "" | *[!0-9*,/-]*) return 1 ;;
    esac
}

# Eine Kopfzeile: Name:Wert. Der Name wie in HTTP ueblich (Buchstaben,
# Ziffern, '-'), der Wert beliebig, aber ohne Leerzeichen (die Zeile ist
# schon in Woerter zerlegt) und ohne Hochkomma (wegen der Crontab-Quotung).
ist_kopfzeile() {
    case "$1" in
        *"'"*) return 1 ;;
        *:*) ;;
        *) return 1 ;;
    esac
    name="${1%%:*}"
    case "$name" in
        "" | *[!A-Za-z0-9-]*) return 1 ;;
    esac
    [ -n "${1#*:}" ]
}

# '%' bedeutet in einer Crontab Zeilenumbruch und muss geschuetzt werden.
krontauglich() { printf '%s' "$1" | sed 's/%/\\%/g'; }

# Liest $JOBS, prueft jede Zeile und schreibt eine Crontab nach $1 sowie
# die Jobliste (Zeitplan<TAB>URL<TAB>Kopfzeilen) nach $2. Bricht bei der
# ersten kaputten Zeile ab — ein halber Zeitplan waere schlimmer als keiner.
uebersetze() {
    ziel="$1"
    jobliste="$2"
    : > "$ziel"
    : > "$jobliste"
    anzahl=0
    nr=0
    while IFS= read -r zeile || [ -n "$zeile" ]; do
        nr=$((nr + 1))
        rest=$(printf '%s' "$zeile" | sed 's/^[[:space:]]*//')
        case "$rest" in ""|"#"*) continue ;; esac

        # shellcheck disable=SC2086
        set -- $rest
        [ $# -ge 6 ] || fehler "$JOBS Zeile $nr: erwartet '<5 Cron-Felder> <URL> [Name:Wert ...]', gefunden: $zeile"
        min="$1"; std="$2"; tag="$3"; monat="$4"; wt="$5"; url="$6"
        for feld in "$min" "$std" "$tag" "$monat" "$wt"; do
            ist_cronfeld "$feld" || fehler "$JOBS Zeile $nr: '$feld' ist kein Cron-Feld (erlaubt: Ziffern * , - /)"
        done
        case "$url" in
            http://*|https://*) ;;
            *) fehler "$JOBS Zeile $nr: URL muss mit http:// oder https:// beginnen: $url" ;;
        esac
        case "$url" in
            *"'"*) fehler "$JOBS Zeile $nr: Hochkomma in der URL wird nicht unterstuetzt" ;;
        esac

        shift 6
        koepfe=""
        for kopf in "$@"; do
            ist_kopfzeile "$kopf" || fehler "$JOBS Zeile $nr: '$kopf' ist keine Kopfzeile (Form Name:Wert, ohne Leerzeichen und Hochkomma)"
            koepfe="$koepfe$kopf "
        done

        # Die Kopfzeilen stehen absichtlich NICHT mit in der Crontab:
        # crond druckt die Job-Kommandozeile in die Logs, und ueber
        # /proc/<pid>/cmdline waere sie auch in `ps` sichtbar — beides
        # kein Platz fuer Secrets. webcron-abruf holt sie sich aus
        # $LAUFDIR/koepfe/<urlhash> (siehe Startmodus unten).
        printf '%s %s %s %s %s webcron-abruf '\''%s'\''\n' \
            "$min" "$std" "$tag" "$monat" "$wt" "$(krontauglich "$url")" >> "$ziel"
        printf '%s %s %s %s %s\t%s\t%s\n' "$min" "$std" "$tag" "$monat" "$wt" "$url" "$koepfe" >> "$jobliste"
        anzahl=$((anzahl + 1))
    done < "$JOBS"
    [ "$anzahl" -gt 0 ] || fehler "$JOBS enthaelt keinen einzigen Job"
}

# Schreibt die Jobliste als Uebersicht — mit maskierten Kopfzeilen-Werten.
# Die Uebersicht landet in Ausgaben und damit in Container-Logs; Header-
# Werte sind Secrets und gehoeren dort nie hinein (die Crontab selbst
# braucht sie, aber die ist eine Datei, kein Log).
liste_jobs() {
    while IFS="$(printf '\t')" read -r plan url koepfe; do
        namen=""
        for kopf in $koepfe; do
            namen="$namen ${kopf%%:*}:***"
        done
        printf '  %s %s%s\n' "$plan" "$url" "$namen"
    done < "$1"
}

CRONTAB_NEU=$(mktemp)
JOBLISTE_NEU=$(mktemp)
uebersetze "$CRONTAB_NEU" "$JOBLISTE_NEU"
anzahl=$(wc -l < "$JOBLISTE_NEU" | tr -d ' ')

case "$MODUS" in
    --pruefen)
        echo "webcron: Konfiguration in Ordnung — $anzahl Job(s):"
        liste_jobs "$JOBLISTE_NEU"
        rm -f "$CRONTAB_NEU" "$JOBLISTE_NEU"
        ;;
    --einmal)
        echo "webcron: rufe jede der $anzahl URL(s) einmal auf"
        fehlschlaege=0
        while IFS="$(printf '\t')" read -r _ url koepfe; do
            # Kopfzeilen enthalten weder Leerzeichen noch Glob-Zeichen —
            # das Aufteilen in Woerter ist hier Absicht.
            # shellcheck disable=SC2086
            webcron-abruf "$url" $koepfe || fehlschlaege=$((fehlschlaege + 1))
        done < "$JOBLISTE_NEU"
        rm -f "$CRONTAB_NEU" "$JOBLISTE_NEU"
        [ "$fehlschlaege" -eq 0 ] || fehler "$fehlschlaege von $anzahl Aufruf(en) fehlgeschlagen"
        ;;
    "")
        mkdir -p "$(dirname "$CRONTAB")" "$LAUFDIR/status"
        cp "$CRONTAB_NEU" "$CRONTAB"
        cp "$JOBLISTE_NEU" "$LAUFDIR/jobs.tsv"

        # Kopfzeilen je URL in Dateien ablegen (statt auf der crond-
        # Kommandozeile, siehe uebersetze) — nur fuer root lesbar.
        rm -rf "$LAUFDIR/koepfe"
        mkdir -p "$LAUFDIR/koepfe"
        chmod 700 "$LAUFDIR/koepfe"
        while IFS="$(printf '\t')" read -r _ url koepfe; do
            [ -n "$koepfe" ] || continue
            kennung=$(printf '%s' "$url" | md5sum | cut -d' ' -f1)
            # shellcheck disable=SC2086
            printf '%s\n' $koepfe > "$LAUFDIR/koepfe/$kennung"
        done < "$LAUFDIR/jobs.tsv"

        rm -f "$CRONTAB_NEU" "$JOBLISTE_NEU"
        echo "webcron: $anzahl Job(s) geladen aus $JOBS:"
        liste_jobs "$LAUFDIR/jobs.tsv"

        # Status-UI: schreibgeschuetzte Uebersicht, standardmaessig nicht
        # nach aussen veroeffentlicht. WEBCRON_UI_PORT=0 schaltet sie ab.
        if [ "$UI_PORT" != "0" ]; then
            httpd -p "$UI_PORT" -h /www
            echo "webcron: Status-UI auf Port $UI_PORT (nur containerintern, sofern nicht veroeffentlicht)"
        else
            echo "webcron: Status-UI abgeschaltet (WEBCRON_UI_PORT=0)"
        fi

        echo "webcron: starte crond (Zeitzone: ${TZ:-UTC})"
        exec crond -f -d "${WEBCRON_LOGLEVEL:-8}"
        ;;
esac
