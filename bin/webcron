#!/bin/sh
# webcron — ruft Cronjob-URLs nach Zeitplan auf.
#
# Fuer Webanwendungen, deren Hoster keine Cronjobs anbietet: Statt des
# fehlenden System-Crons ruft dieser Container die Cron-URL der Anwendung
# (wp-cron.php, cron.php, …) nach Zeitplan per HTTP auf.
#
# Aufrufarten:
#   webcron             Konfiguration pruefen, dann supercronic starten (Normalfall)
#   webcron --pruefen   nur die Konfiguration pruefen
#   webcron --einmal    jede URL sofort genau einmal aufrufen; Exit != 0,
#                       sobald ein Aufruf scheitert (fuer Probelaeufe/Tests)
#
# Konfiguration: /config/jobs.cron (WEBCRON_JOBS), eine Zeile je Aufruf:
#   <Minute> <Stunde> <Monatstag> <Monat> <Wochentag> <URL> [Name:Wert ...]
# Alles nach der URL sind HTTP-Kopfzeilen, z. B. X-Cron-Secret:abc123 —
# der richtige Platz fuer Secrets, denn anders als der Query-String tauchen
# Kopfzeilen nicht in Access-Logs auf.
set -eu
# Kein Globbing: Cron-Felder wie '*' werden unten per `set --` in Woerter
# zerlegt und wuerden sonst zu Dateinamen expandieren.
set -f

JOBS="${WEBCRON_JOBS:-/config/jobs.cron}"
LAUFDIR="${WEBCRON_LAUFDIR:-/run/webcron}"
CRONTAB="${WEBCRON_CRONTAB:-$LAUFDIR/crontab}"
UI_PORT="${WEBCRON_UI_PORT:-8080}"
MODUS="${1:-}"
DROP=""
# Benutzer, unter dem der Zeitplaner und die Abrufe laufen (siehe Dockerfile).
DIENST_NUTZER="${WEBCRON_DIENST_NUTZER:-webcron}"

# URL fuer Anzeige und Logs: Zugangsdaten (user:pw@) und Query-String
# koennen Secrets tragen und werden maskiert.
anzeige_url() {
    u="$1"
    case "$u" in *\?*) u="${u%%\?*}?***" ;; esac
    schema="${u%%://*}"
    rest="${u#*://}"
    auth="${rest%%/*}"
    case "$auth" in
        *@*) pfad="${rest#"$auth"}"; u="$schema://***@${auth#*@}$pfad" ;;
    esac
    printf '%s' "$u"
}

fehler() { echo "webcron: $*" >&2; exit 1; }

case "$MODUS" in
    ""|--pruefen|--einmal) ;;
    *) fehler "unbekannter Aufruf '$MODUS' — erlaubt sind --pruefen und --einmal" ;;
esac

[ -f "$JOBS" ] || fehler "Konfiguration fehlt: $JOBS
Eine Datei mit Zeilen '<5 Cron-Felder> <URL> [Name:Wert ...]' dorthin
mounten, Vorlage: jobs.example.cron im Repo."

# Ohne Leserecht scheitert das Einlesen spaeter mit einer unverstaendlichen
# Meldung. Typischer Fall: eine Datei mit Rechten 0600, die einem normalen
# Nutzer gehoert -- root im Container hat unter `cap_drop: ALL` kein
# CAP_DAC_OVERRIDE und darf sie dann nicht lesen.
# (Wirklich oeffnen statt `[ -r ]`: Fuer root liefert test je nach Build immer wahr.)
( : < "$JOBS" ) 2>/dev/null || fehler "$JOBS ist nicht lesbar. Besitzer und Rechte der Datei auf dem Host
setzen, z. B.: sudo chown root:root jobs.cron && sudo chmod 600 jobs.cron
(root im Container ist ohne CAP_DAC_OVERRIDE nur dann leseberechtigt, wenn
er Besitzer ist)."

# Kann der Prozess der Status-UI (nobody) die Datei lesen? Naeherung ueber
# die Rechte "andere": Datei lesbar und jedes Verzeichnis davor durchsuchbar.
# Im Normalfall (Einzeldatei nach /config/jobs.cron gemountet) schuetzt schon
# das Verzeichnis /config (0700) im Abbild.
fuer_andere_lesbar() {
    pfad=$(readlink -f "$1" 2>/dev/null) || pfad="$1"
    modus=$(stat -c %a "$pfad" 2>/dev/null) || return 1
    case "$modus" in *[4567]) ;; *) return 1 ;; esac
    verz="$pfad"
    while [ "$verz" != "/" ]; do
        verz=$(dirname "$verz")
        modus=$(stat -c %a "$verz" 2>/dev/null) || return 1
        case "$modus" in *[1357]) ;; *) return 1 ;; esac
    done
}

# Zahl ohne fuehrende Nullen ('07' -> 7; '08' waere in $(( )) ungueltig oktal).
# Mehr als 5 Stellen sind nie ein Cron-Wert (und wuerden $(( )) ueberlaufen).
ohne_nullen() {
    n="$1"
    case "$n" in "" | *[!0-9]* | ??????*) return 1 ;; esac
    while :; do
        case "$n" in 0?*) n="${n#0}" ;; *) break ;; esac
    done
}

# Ein Cron-Feld mit Wertebereich: ist_cronfeld <Feld> <kleinster> <groesster>.
# Erlaubt sind Listen (,) aus '*', Zahl, Bereich a-b, jeweils mit Schritt
# (*/n, a-b/n); Schritt nur nach '*' oder einem Bereich -- '0/15' deutet
# busybox anders als mancher erwartet (nur der Wert 0). Jede Zahl muss im
# Bereich liegen: busybox-crond zaehlt sonst modulo Feldbreite weiter,
# setzt jeden Eintrag des Feldes und meldet erst danach "parse error" --
# '0 3 * * 7' liefe dann jeden Tag.
ist_cronfeld() {
    feld="$1"; lo="$2"; hi="$3"
    case "$feld" in
        "" | *[!0-9*,/-]* | ,* | *, | *,,*) return 1 ;;
    esac
    ifs_alt="$IFS"
    IFS=,
    # shellcheck disable=SC2086
    set -- $feld
    IFS="$ifs_alt"
    for teil in "$@"; do
        bereich="${teil%%/*}"
        schritt=""
        case "$teil" in
            */*)
                schritt="${teil#*/}"
                ohne_nullen "$schritt" || return 1
                schritt="$n"
                [ "$schritt" -ge 1 ] && [ "$schritt" -le $((hi - lo + 1)) ] || return 1
                ;;
        esac
        case "$bereich" in
            "*") ;;
            *-*)
                von="${bereich%-*}"; bis="${bereich#*-}"
                ohne_nullen "$von" || return 1; von="$n"
                ohne_nullen "$bis" || return 1; bis="$n"
                [ "$von" -ge "$lo" ] && [ "$von" -le "$bis" ] && [ "$bis" -le "$hi" ] || return 1
                ;;
            *)
                [ -z "$schritt" ] || return 1
                ohne_nullen "$bereich" || return 1
                [ "$n" -ge "$lo" ] && [ "$n" -le "$hi" ] || return 1
                ;;
        esac
    done
}

# Eine Kopfzeile: Name:Wert. Der Name wie in HTTP ueblich (Buchstaben,
# Ziffern, '-'), der Wert beliebig, aber ohne Leerzeichen (die Zeile ist
# schon in Woerter zerlegt) und ohne Hochkomma.
ist_kopfzeile() {
    case "$1" in
        *"'"*) return 1 ;;
        *:*) ;;
        *) return 1 ;;
    esac
    name="${1%%:*}"
    case "$name" in
        "" | *[!A-Za-z0-9-]*) return 1 ;;
    esac
    [ -n "${1#*:}" ]
}

# Liest $JOBS, prueft jede Zeile und schreibt
#   - eine Crontab nach $1; sie nennt je Job nur dessen Nummer
#     (`webcron-abruf --job <nr>`), weder URL noch Kopfzeilen: crond
#     protokolliert die Job-Kommandozeile, und ueber /proc waere sie
#     in `ps` sichtbar -- beides kein Platz fuer Secrets,
#   - die Jobliste fuer die Anzeige nach $2 (Zeitplan<TAB>maskierte URL
#     <TAB>Kopfzeilen-Namen<TAB>Nummer), ohne Werte,
#   - je Job eine Datei $3/<nr> mit der URL (1. Zeile) und den
#     Kopfzeilen (eine je Zeile); das Verzeichnis ist nur fuer den Dienst-Benutzer lesbar.
# Bricht bei der ersten kaputten Zeile ab -- ein halber Zeitplan waere
# schlimmer als keiner.
uebersetze() {
    ziel="$1"
    jobliste="$2"
    jobdir="$3"
    : > "$ziel"
    : > "$jobliste"
    anzahl=0
    nr=0
    while IFS= read -r zeile || [ -n "$zeile" ]; do
        nr=$((nr + 1))
        # UTF-8-BOM am Dateianfang (z. B. von PowerShell 5.1) entfernen.
        [ "$nr" -ne 1 ] || zeile="${zeile#"$(printf '\357\273\277')"}"
        # Windows-Zeilenende (CRLF) tolerieren, sonstige Steuerzeichen ablehnen
        # (ein \r am Zeilenende haengt sonst unbemerkt an der URL/dem Header).
        zeile="${zeile%"$(printf '\r')"}"
        case "$(printf '%s' "$zeile" | tr -d '\t')" in
            *[[:cntrl:]]*) fehler "$JOBS Zeile $nr: Steuerzeichen sind nicht erlaubt" ;;
        esac
        rest=$(printf '%s' "$zeile" | sed 's/^[[:space:]]*//')
        case "$rest" in ""|"#"*) continue ;; esac

        # shellcheck disable=SC2086
        set -- $rest
        # Meldungen nennen nie Teile der Zeile (URL, Kopfzeilen-Werte): sie
        # landen in `docker logs`, und bei jedem Neustart erneut.
        [ $# -ge 6 ] || fehler "$JOBS Zeile $nr: erwartet '<5 Cron-Felder> <URL> [Name:Wert ...]', aber nur $# Wort/Woerter"
        min="$1"; std="$2"; tag="$3"; monat="$4"; wt="$5"; url="$6"
        pos=0
        for feld in "$min" "$std" "$tag" "$monat" "$wt"; do
            pos=$((pos + 1))
            case "$pos" in
                1) lo=0; hi=59; art="Minute" ;;
                2) lo=0; hi=23; art="Stunde" ;;
                3) lo=1; hi=31; art="Monatstag" ;;
                4) lo=1; hi=12; art="Monat" ;;
                *) lo=0; hi=6;  art="Wochentag, Sonntag ist 0" ;;
            esac
            ist_cronfeld "$feld" "$lo" "$hi" || fehler "$JOBS Zeile $nr: das ${pos}. Wort ist kein gueltiges Cron-Feld ($art, erlaubt $lo-$hi, dazu * , - /)"
        done
        case "$url" in
            http://*|https://*) ;;
            *) fehler "$JOBS Zeile $nr: die URL (6. Wort) muss mit http:// oder https:// beginnen" ;;
        esac
        case "$url" in
            *"'"*) fehler "$JOBS Zeile $nr: Hochkomma in der URL wird nicht unterstuetzt" ;;
        esac

        shift 6
        namen=""
        knr=0
        for kopf in "$@"; do
            knr=$((knr + 1))
            ist_kopfzeile "$kopf" || fehler "$JOBS Zeile $nr: Kopfzeile $knr ist ungueltig (Form Name:Wert, Name aus Buchstaben, Ziffern und '-', Wert ohne Leerzeichen und Hochkomma)"
            namen="$namen ${kopf%%:*}"
        done

        anzahl=$((anzahl + 1))
        {
            printf '%s\n' "$url"
            [ $# -eq 0 ] || printf '%s\n' "$@"
        } > "$jobdir/$anzahl"
        printf '%s %s %s %s %s webcron-abruf --job %s\n' \
            "$min" "$std" "$tag" "$monat" "$wt" "$anzahl" >> "$ziel"
        namen="${namen# }"
        printf '%s %s %s %s %s\t%s\t%s\t%s\n' "$min" "$std" "$tag" "$monat" "$wt" \
            "$(anzeige_url "$url")" "${namen:--}" "$anzahl" >> "$jobliste"
    done < "$JOBS"
    [ "$anzahl" -gt 0 ] || fehler "$JOBS enthaelt keinen einzigen Job"
}

# Schreibt die Jobliste als Uebersicht -- mit maskierten Kopfzeilen-Werten.
# Die Uebersicht landet in Ausgaben und damit in Container-Logs; Header-
# Werte sind Secrets und gehoeren dort nie hinein.
liste_jobs() {
    while IFS="$(printf '\t')" read -r plan url namen _; do
        anz=""
        for n in $namen; do
            [ "$n" = "-" ] || anz="$anz $n:***"
        done
        printf '  %s %s%s\n' "$plan" "$url" "$anz"
    done < "$1"
}

CRONTAB_NEU=$(mktemp)
JOBLISTE_NEU=$(mktemp)
JOBDIR_NEU=$(mktemp -d)
chmod 700 "$JOBDIR_NEU"
aufraeumen() { rm -rf "$CRONTAB_NEU" "$JOBLISTE_NEU" "$JOBDIR_NEU"; }
trap aufraeumen EXIT
uebersetze "$CRONTAB_NEU" "$JOBLISTE_NEU" "$JOBDIR_NEU"
anzahl=$(wc -l < "$JOBLISTE_NEU" | tr -d ' ')

# Die Jobdateien (URL und Kopfzeilen) fuer webcron-abruf bereitstellen,
# alte Staende und Status verwerfen: die Nummern gelten nur fuer diese
# Konfiguration.
#
# DROP ist leer (alles als aktueller Benutzer) oder `su-exec <nutzer>:<gruppe>`:
# Im Normalbetrieb schreibt webcron diese Dateien AS $DIENST_NUTZER, statt sie
# als root anzulegen und zu uebergeben. Das braucht weder CAP_CHOWN noch
# CAP_DAC_OVERRIDE (beide fehlen unter `cap_drop: ALL`), und die Dateien
# gehoeren von Anfang an dem Benutzer, der sie spaeter liest. Was root liest
# (Konfiguration, Zwischendateien), reicht root per Umleitung durch.
als_dienst() { $DROP "$@"; }
installiere_jobs() {
    als_dienst mkdir -p "$LAUFDIR"
    als_dienst rm -rf "$LAUFDIR/jobs" "$LAUFDIR/koepfe" "$LAUFDIR/status"
    als_dienst mkdir -m 700 "$LAUFDIR/jobs"
    tar -c -C "$JOBDIR_NEU" . | als_dienst tar -x -C "$LAUFDIR/jobs"
    als_dienst mkdir "$LAUFDIR/status"
}

# Legt $2 als Datei $1 an (Modus 644, Besitzer ist der Dienst-Benutzer).
schreibe_datei() {
    # shellcheck disable=SC2016 # $1 soll erst in der Unter-Shell expandieren
    als_dienst sh -c 'cat > "$1"' _ "$1" < "$2"
}

# Die Status-UI laeuft als nobody. Ist die Konfiguration fuer alle lesbar,
# liest nobody damit alle Secrets darin -- wer die UI erreicht und eine
# Luecke im httpd/CGI ausnutzt, bekaeme sie. Nur Warnung: Der Betrieb
# bleibt moeglich, die Rechte ist Sache des Betreibers.
warne_wenn_lesbar() {
    [ "$UI_PORT" != "0" ] || return 0
    if fuer_andere_lesbar "$JOBS"; then
        echo "webcron: WARNUNG: $JOBS ist fuer alle Nutzer im Container lesbar, auch fuer die" >&2
        echo "webcron: Status-UI (nobody). Auf dem Host: sudo chown root:root jobs.cron &&" >&2
        echo "webcron: sudo chmod 600 jobs.cron -- und die Datei als Einzeldatei nach" >&2
        echo "webcron: /config/jobs.cron mounten, nicht das ganze Verzeichnis." >&2
    fi
}

case "$MODUS" in
    --pruefen)
        warne_wenn_lesbar
        echo "webcron: Konfiguration in Ordnung — $anzahl Job(s):"
        liste_jobs "$JOBLISTE_NEU"
        ;;
    --einmal)
        echo "webcron: rufe jede der $anzahl URL(s) einmal auf"
        installiere_jobs
        fehlschlaege=0
        nr=1
        while [ "$nr" -le "$anzahl" ]; do
            webcron-abruf --job "$nr" || fehlschlaege=$((fehlschlaege + 1))
            nr=$((nr + 1))
        done
        [ "$fehlschlaege" -eq 0 ] || fehler "$fehlschlaege von $anzahl Aufruf(en) fehlgeschlagen"
        ;;
    "")
        warne_wenn_lesbar
        # Ab hier braucht nichts mehr root: Wer als root gestartet ist
        # (Normalfall; root liest die nur fuer root lesbare Konfiguration),
        # gibt die Rechte ab. Die Status-UI geht an "nobody", der Zeitplaner
        # an $DIENST_NUTZER. Nach dem exec unten laeuft im Container kein
        # Prozess mehr als root. Bei einem Start ohne root (z. B. `--user`)
        # entfaellt der Wechsel, dann teilen sich UI und Zeitplaner den
        # Benutzer.
        if [ "$(id -u)" = 0 ]; then
            DROP="su-exec $DIENST_NUTZER:$DIENST_NUTZER"
            UI_NUTZER="-u nobody"
        else
            DROP=""
            UI_NUTZER=""
            echo "webcron: WARNUNG: nicht als root gestartet; Status-UI und Zeitplaner teilen sich den Benutzer" >&2
        fi
        installiere_jobs
        # Die Dateien sind fuer alle lesbar (644): Die Status-UI (nobody) liest
        # die maskierte Liste, der Zeitplaner die Crontab; beide nennen nur
        # Jobnummern bzw. maskierte URLs, keine Secrets.
        als_dienst mkdir -p "$(dirname "$CRONTAB")"
        schreibe_datei "$CRONTAB" "$CRONTAB_NEU"
        schreibe_datei "$LAUFDIR/jobs.tsv" "$JOBLISTE_NEU"

        echo "webcron: $anzahl Job(s) geladen aus $JOBS:"
        liste_jobs "$LAUFDIR/jobs.tsv"

        # Status-UI: schreibgeschuetzte Uebersicht, standardmaessig nicht
        # nach aussen veroeffentlicht. WEBCRON_UI_PORT=0 schaltet sie ab.
        if [ "$UI_PORT" != "0" ]; then
            # Als "nobody": Der netzseitige Prozess braucht nur jobs.tsv
            # (maskiert) und status/, nie die Jobdateien mit den Secrets.
            # shellcheck disable=SC2086
            httpd $UI_NUTZER -p "$UI_PORT" -h /www
            echo "webcron: Status-UI auf Port $UI_PORT (nur containerintern, sofern nicht veroeffentlicht)"
        else
            echo "webcron: Status-UI abgeschaltet (WEBCRON_UI_PORT=0)"
        fi

        # exec ersetzt die Shell, der trap-Aufraeumer laeuft dann nicht
        # mehr: die Dateien selbst sind schon kopiert.
        rm -rf "$CRONTAB_NEU" "$JOBLISTE_NEU" "$JOBDIR_NEU"
        # Gespraechigkeit: wie zuvor beim busybox-crond zaehlt WEBCRON_LOGLEVEL
        # (Standard 8); kleiner als 8 schaltet die Fehlersuche ein, groesser
        # als 8 lasst supercronic bis auf Fehler schweigen.
        loglevel="${WEBCRON_LOGLEVEL:-8}"
        case "$loglevel" in
            "" | *[!0-9]*) loglevel=8 ;;
        esac
        if [ "$loglevel" -lt 8 ]; then
            sc_art="-debug"
        elif [ "$loglevel" -gt 8 ]; then
            sc_art="-quiet"
        else
            sc_art=""
        fi
        echo "webcron: starte supercronic (Zeitzone: ${TZ:-UTC}, Benutzer: ${DROP:+$DIENST_NUTZER}${DROP:-$(id -un)})"
        # shellcheck disable=SC2086
        exec $DROP supercronic $sc_art "$CRONTAB"
        ;;
esac
