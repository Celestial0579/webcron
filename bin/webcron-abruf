#!/bin/sh
# Ruft den Job mit der angegebenen Nummer auf, protokolliert das Ergebnis
# und schreibt den Stand fuer die Status-UI fort. Wird von supercronic je
# Zeitplan-Takt gestartet.
#
# Aufruf: webcron-abruf --job <nr>
# URL und Kopfzeilen stehen in $LAUFDIR/jobs/<nr> (nur fuer den Dienst-Benutzer lesbar,
# von `webcron` beim Start angelegt). Sie stehen absichtlich nirgends auf
# einer Kommandozeile: supercronic protokolliert sie, und ueber /proc waeren sie in `ps`
# sichtbar -- kein Platz fuer Secrets. Auch curl bekommt sie nicht als
# Argumente, sondern als Konfiguration ueber stdin.
set -u

# URL fuer Anzeige und Logs: Zugangsdaten (user:pw@) und Query-String
# koennen Secrets tragen und werden maskiert.
anzeige_url() {
    u="$1"
    case "$u" in *\?*) u="${u%%\?*}?***" ;; esac
    schema="${u%%://*}"
    rest="${u#*://}"
    auth="${rest%%/*}"
    case "$auth" in
        *@*) pfad="${rest#"$auth"}"; u="$schema://***@${auth#*@}$pfad" ;;
    esac
    printf '%s' "$u"
}

[ "${1:-}" = "--job" ] || { echo "Aufruf: webcron-abruf --job <nr>" >&2; exit 2; }
JOB="${2:-}"
case "$JOB" in
    "" | *[!0-9]*) echo "webcron-abruf: ungueltige Jobnummer '$JOB'" >&2; exit 2 ;;
esac

LAUFDIR="${WEBCRON_LAUFDIR:-/run/webcron}"
STATUSDIR="$LAUFDIR/status"
JOBDATEI="$LAUFDIR/jobs/$JOB"
[ -f "$JOBDATEI" ] || { echo "webcron-abruf: Job $JOB nicht gefunden" >&2; exit 2; }

IFS= read -r URL < "$JOBDATEI"
KOPFZEILEN=$(sed 1d "$JOBDATEI")

TIMEOUT="${WEBCRON_TIMEOUT:-60}"
VERSUCHE="${WEBCRON_VERSUCHE:-2}"
AGENT="${WEBCRON_USER_AGENT:-webcron (+https://github.com/Celestial0579/webcron)}"

# Geloggt wird direkt auf stdout/stderr von PID 1, denn dort lesen die
# Container-Logs mit. Ausserhalb eines Containers: gewoehnliches stdout.
OUT=/proc/1/fd/1
ERR=/proc/1/fd/2
[ -w "$OUT" ] || { OUT=/dev/stdout; ERR=/dev/stderr; }

# Zeichenketten fuer eine curl-Konfigurationsdatei: \ und " maskieren.
curl_text() { printf '%s' "$1" | sed 's/\\/\\\\/g; s/"/\\"/g'; }

# Weiterleitungen: Kopfzeilen (Secrets) duerfen nie an ein anderes Ziel
# gehen als das konfigurierte -- curl schickt -H-Kopfzeilen bei jeder
# Weiterleitung mit, auch zu fremden Hosts und ueber http. Jobs mit
# Kopfzeilen folgen deshalb keiner Weiterleitung; die URL in der
# Konfiguration muss das endgueltige Ziel sein. Jobs ohne Kopfzeilen folgen
# ihnen, aber nie von https auf http.
case "$URL" in
    https://*) protokolle="=https" ;;
    *)         protokolle="=http,https" ;;
esac
if [ -n "$KOPFZEILEN" ]; then
    folgen=""
else
    folgen="--location --max-redirs 10 --proto-redir $protokolle"
fi

# curl-Fehlermeldungen koennen die URL enthalten (Query-String, user:pw@).
# stderr geht deshalb erst in eine Datei und wird maskiert weitergereicht.
# `--globoff` verhindert zudem, dass curl [..] und {..} in der URL als Muster
# auswertet (ein ungueltiges Muster liess curl die ganze URL ausgeben, ein
# gueltiges loeste mehrere Aufrufe je Takt aus).
# Ohne Zwischendatei kein Abruf; die Trap steht erst nach dem Erfolg (sonst
# loeschte sie bei leerem/falschem Namen etwas anderes).
FEHLDATEI=$(mktemp "$LAUFDIR/curl-fehler.XXXXXX") || {
    echo "webcron-abruf: kann keine Zwischendatei in $LAUFDIR anlegen" >&2
    exit 2
}
trap 'rm -f "$FEHLDATEI"' EXIT
maskiere() {
    sed -E 's#(://)[^/@[:space:]]*@#\1***@#g; s#\?[^[:space:]]*#?***#g'
}

start=$(date +%s)
# shellcheck disable=SC2086
antwort=$(
    {
        printf 'url = "%s"\n' "$(curl_text "$URL")"
        printf '%s\n' "$KOPFZEILEN" | while IFS= read -r kopf; do
            [ -n "$kopf" ] && printf 'header = "%s"\n' "$(curl_text "$kopf")"
        done
    } | curl --silent --show-error --globoff --output /dev/null \
        --write-out '%{http_code} %{redirect_url}' \
        --max-time "$TIMEOUT" $folgen \
        --retry "$VERSUCHE" --retry-connrefused \
        --user-agent "$AGENT" --config - 2>"$FEHLDATEI"
) || antwort="000 "
[ ! -s "$FEHLDATEI" ] || maskiere < "$FEHLDATEI" >> "$ERR"
code="${antwort%% *}"
weiter="${antwort#* }"
dauer=$(( $(date +%s) - start ))
zeit=$(date '+%Y-%m-%d %H:%M:%S')

case "$code" in
    2*) ergebnis=OK ;;
    3*) if [ -n "$KOPFZEILEN" ]; then ergebnis=FEHLER; else ergebnis=OK; fi ;;
    *)  ergebnis=FEHLER ;;
esac

# Stand fuer die Status-UI: eine Datei je Job, benannt nach seiner Nummer.
# Format: Zeit, HTTP-Code, Dauer, Ergebnis, Zaehler OK, Zaehler Fehler.
mkdir -p "$STATUSDIR"
ok_bisher=0
fehler_bisher=0
if [ -f "$STATUSDIR/$JOB" ]; then
    IFS="$(printf '\t')" read -r _ _ _ _ ok_bisher fehler_bisher < "$STATUSDIR/$JOB" || true
fi
if [ "$ergebnis" = OK ]; then
    ok_bisher=$((ok_bisher + 1))
else
    fehler_bisher=$((fehler_bisher + 1))
fi
printf '%s\t%s\t%s\t%s\t%s\t%s\n' \
    "$zeit" "$code" "$dauer" "$ergebnis" "$ok_bisher" "$fehler_bisher" \
    > "$STATUSDIR/$JOB"

anzeige=$(anzeige_url "$URL")
if [ "$ergebnis" = OK ]; then
    echo "$zeit  OK      HTTP $code  ${dauer}s  $anzeige" >> "$OUT"
else
    echo "$zeit  FEHLER  HTTP $code  ${dauer}s  $anzeige" >> "$ERR"
    case "$code" in
        3*) echo "$zeit  Weiterleitung nach $(anzeige_url "$weiter") nicht befolgt: Jobs mit Kopfzeilen folgen keiner Weiterleitung, die URL in der Konfiguration anpassen" >> "$ERR" ;;
    esac
    exit 1
fi
