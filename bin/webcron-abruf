#!/bin/sh
# Ruft eine einzelne Cronjob-URL auf, protokolliert das Ergebnis und
# schreibt den Stand fuer die Status-UI fort. Wird von crond je
# Zeitplan-Takt gestartet.
#
# Aufruf: webcron-abruf <url> [Name:Wert ...]
# Kopfzeilen kommen als Argumente (Einmal-Modus) — oder, wenn keine
# uebergeben wurden, aus $LAUFDIR/koepfe/<urlhash>. Auf der crond-
# Kommandozeile stehen sie absichtlich nicht: crond loggt sie, und ueber
# /proc waeren sie in `ps` sichtbar — kein Platz fuer Secrets.
set -u

URL="${1:?Aufruf: webcron-abruf <url> [Name:Wert ...]}"
shift

LAUFDIR="${WEBCRON_LAUFDIR:-/run/webcron}"
STATUSDIR="$LAUFDIR/status"
kennung=$(printf '%s' "$URL" | md5sum | cut -d' ' -f1)

if [ $# -eq 0 ] && [ -f "$LAUFDIR/koepfe/$kennung" ]; then
    while IFS= read -r kopf; do
        [ -n "$kopf" ] && set -- "$@" "$kopf"
    done < "$LAUFDIR/koepfe/$kennung"
fi

# Die Kopfzeilen in curl-Form bringen: aus 'Name:Wert' wird
# '-H Name:Wert'. Danach steht die fertige Argumentliste wieder in "$@".
restliche=$#
while [ "$restliche" -gt 0 ]; do
    kopf="$1"; shift
    set -- "$@" -H "$kopf"
    restliche=$((restliche - 1))
done
TIMEOUT="${WEBCRON_TIMEOUT:-60}"
VERSUCHE="${WEBCRON_VERSUCHE:-2}"
AGENT="${WEBCRON_USER_AGENT:-webcron (+https://github.com/Celestial0579/webcron)}"

# crond reicht die Ausgabe seiner Jobs nirgendwohin weiter — geloggt wird
# deshalb direkt auf stdout/stderr von PID 1, denn dort lesen die
# Container-Logs mit. Ausserhalb eines Containers: gewoehnliches stdout.
OUT=/proc/1/fd/1
ERR=/proc/1/fd/2
[ -w "$OUT" ] || { OUT=/dev/stdout; ERR=/dev/stderr; }

start=$(date +%s)
code=$(curl --silent --show-error --output /dev/null --write-out '%{http_code}' \
    --location --max-time "$TIMEOUT" \
    --retry "$VERSUCHE" --retry-connrefused \
    --user-agent "$AGENT" "$@" "$URL" 2>>"$ERR") || code=000
dauer=$(( $(date +%s) - start ))
zeit=$(date '+%Y-%m-%d %H:%M:%S')

case "$code" in
    2*|3*) ergebnis=OK ;;
    *)     ergebnis=FEHLER ;;
esac

# Stand fuer die Status-UI: eine Datei je URL, benannt nach ihrem Hash.
# Format: Zeit, HTTP-Code, Dauer, Ergebnis, Zaehler OK, Zaehler Fehler.
mkdir -p "$STATUSDIR"
kennung=$(printf '%s' "$URL" | md5sum | cut -d' ' -f1)
ok_bisher=0
fehler_bisher=0
if [ -f "$STATUSDIR/$kennung" ]; then
    IFS="$(printf '\t')" read -r _ _ _ _ ok_bisher fehler_bisher < "$STATUSDIR/$kennung" || true
fi
if [ "$ergebnis" = OK ]; then
    ok_bisher=$((ok_bisher + 1))
else
    fehler_bisher=$((fehler_bisher + 1))
fi
printf '%s\t%s\t%s\t%s\t%s\t%s\n' \
    "$zeit" "$code" "$dauer" "$ergebnis" "$ok_bisher" "$fehler_bisher" \
    > "$STATUSDIR/$kennung"

if [ "$ergebnis" = OK ]; then
    echo "$zeit  OK      HTTP $code  ${dauer}s  $URL" >> "$OUT"
else
    echo "$zeit  FEHLER  HTTP $code  ${dauer}s  $URL" >> "$ERR"
    exit 1
fi
